<dialog id="loginDialog" class="dialog" aria-modal="true" aria-label="Нэвтрэх цонх" role="dialog">
<form method="dialog" onsubmit="closeLogin(); return false;">
<h2>Нэвтрэх</h2>
<label for="loginEmail">И-мэйл</label><input id="loginEmail" type="email" required placeholder="you@email.mn"/>
<label for="loginPass">Нууц үг</label><input id="loginPass" type="password" required placeholder="••••••••"/>
<button type="submit" class="btn btn-primary">Нэвтрэх</button>
<button type="button" class="btn btn-ghost" onclick="closeLogin()">Болих</button>
</form>
</dialog>

<dialog id="registerDialog" class="dialog" aria-modal="true" aria-label="Бүртгүүлэх цонх" role="dialog">
<form method="dialog" onsubmit="closeRegister(); showToast('Бүртгэлийн хүсэлт хүлээн авлаа'); return false;">
<h2>Бүртгэгдэх</h2>
<label for="regName">Нэр</label><input id="regName" type="text" required placeholder="Нэр"/>
<label for="regEmail">И-мэйл</label><input id="regEmail" type="email" required placeholder="you@email.mn"/>
<label for="regPass">Нууц үг</label><input id="regPass" type="password" required placeholder="••••••••"/>
<button type="submit" class="btn btn-primary">Бүртгүүлэх</button>
<button type="button" class="btn btn-ghost" onclick="closeRegister()">Болих</button>
</form>
</dialog>

<div id="toast" class="toast" role="status" aria-live="polite" aria-atomic="true"></div>

<button onclick="window.scrollTo({top:0,behavior:'smooth'})" class="btn-back-top" aria-label="Дээд рүү">↑</button>

<script src="main.js"></script>
<script src="cursor-trail.js" defer></script>

<!-- Decorative extended section for longer scroll + small details -->
<section id="details" aria-label="Small decorative details" style="padding:8rem 3vw; background:linear-gradient(180deg,#f8f6f2 0%,#ece9df 100%); position:relative; overflow:hidden;">
  <div style="max-width:1200px; margin:0 auto; display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:3rem; align-items:start;">
    <article style="padding:2rem; background:#fff; border-radius:var(--radius); box-shadow:0 20px 60px rgba(0,0,0,.06);">
      <h3 style="font-family:var(--font-display); font-size:1.6rem; margin-bottom:.6rem; color:var(--ink);">Мэдээлэл</h3>
      <p style="color:var(--ink-faint); font-size:.95rem; line-height:1.65;">Жижиг нарийн чанар, өнгөний хослол болон картын хөдөлгөөн нь сайтын уртыг уртасгаж, хэрэглэгчийн анхаарлыг хандуулна.</p>
      <div style="margin-top:1.5rem; display:flex; gap:.5rem;">
        <span style="width:10px; height:10px; border-radius:50%; background:var(--gold); box-shadow:0 0 8px rgba(196,180,154,.5);"></span>
        <span style="width:10px; height:10px; border-radius:50%; background:var(--accent); box-shadow:0 0 8px rgba(44,62,80,.5);"></span>
        <span style="width:10px; height:10px; border-radius:50%; background:var(--warm); box-shadow:0 0 8px rgba(139,115,75,.5);"></span>
      </div>
    </article>
    <article style="padding:2rem; background:var(--ink); border-radius:var(--radius); box-shadow:0 20px 60px rgba(0,0,0,.18); color:#fff;">
      <h3 style="font-family:var(--font-display); font-size:1.6rem; margin-bottom:.6rem;">Холбоо</h3>
      <p style="color:#aaa; font-size:.95rem; line-height:1.65;">Сайтын урт уртасгахын тулд нэмэлт хэсэг нэмлээ. Скроллtrigger хөдөлгөөн нь шинэ хэсэгт ажиллана.</p>
      <p style="margin-top:1rem; color:var(--gold); font-weight:600; font-size:.9rem;">ScrollTrigger + Cursor orbit + 3 trailing dots</p>
    </article>
  </div>
  <!-- Small floating decorative dots -->
  <div style="position:absolute; top:10%; left:15%; pointer-events:none; z-index:0;">
    <div style="width:20px;height:20px;border-radius:50%;background:rgba(196,180,154,.2);animation:dotFloat 6s ease-in-out infinite alternate;"></div>
    <div style="width:12px;height:12px;border-radius:50%;background:rgba(196,180,154,.15);animation:dotFloat 8s ease-in-out infinite alternate;animation-delay:1s;margin-top:30px;margin-left:40px;"></div>
    <div style="width:16px;height:16px;border-radius:50%;background:rgba(44,62,80,.15);animation:dotFloat 7s ease-in-out infinite alternate;animation-delay:.6s;margin-top:20px;margin-left:-20px;"></div>
  </div>
  <style>@keyframes dotFloat{from{transform:translateY(0)}to{transform:translateY(-25px)}}</style>
</section>
</body>
</html>
